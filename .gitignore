# secrets — never commit (the only keys live here; see .env.example)
.env
editor.token

# python
__pycache__/
*.pyc

# Model outputs are TRACKED on purpose: narration, keyframes, panels, cast
# portraits and the score are the expensive, logged evidence, and with them a
# clone rebuilds both films from `make short` with no API keys at all (keys
# are only asked for on a real cache miss). runs.jsonl and manifests are
# tracked too.
#
# What is rebuilt on every run is not tracked:
# render intermediates (picture, master.wav)
outputs/comic/
# deterministic edit of the tracked narration
outputs/narration_fit/
# the films themselves: `make short`, or the GitHub Release
outputs/film_*.mp4
# rebuild with tools/build_bundles.py
outputs/kaggle_upload/
# identical copy of score_final.wav
outputs/music/score_qenet.wav

# kaggle working files
kaggle/*.zip

# OS
.DS_Store

# comic renderer build artefacts: the Rust source, Cargo.lock, panels.json and
# the fonts in media/ are tracked; the media copies and film.json are written
# by pipeline/comic.py, and target/ is 2.8 GB of build cache.
comic/target/
comic/frames/
comic/media/panel_*
comic/media/ins_*
comic/media/re_*
comic/film.json
comic/*.mp4

# local snapshot of the whole project
archives/

# local scratch from story iterations (kept on disk, out of the repo)
storyboard.backup.json
design_cast_note.json
