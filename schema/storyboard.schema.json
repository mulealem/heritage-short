{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["meta", "character_sheet", "music", "end_card", "shots"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "narration_language", "aspect_ratios", "audience", "intent", "style_block", "image_width", "image_height"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "title_local": { "type": "string", "description": "the title in the story's own language, e.g. Amharic, for the end card" },
        "status": { "type": "string", "enum": ["draft", "locked"] },
        "narration_language": { "type": "string", "minLength": 2, "description": "BCP-47-ish code, e.g. en, am, om, ti, so" },
        "aspect_ratios": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "type": "string", "enum": ["9:16", "16:9"] }
        },
        "audience": { "type": "string", "minLength": 10 },
        "intent": { "type": "string", "minLength": 10 },
        "narrator_style": { "type": "string", "description": "plain-language TTS style instruction, e.g. 'calm, warm, unhurried'" },
        "style_block": { "type": "string", "minLength": 10, "description": "fixed look description prepended to every image prompt" },
        "image_width": { "type": "integer", "minimum": 256, "maximum": 2048 },
        "image_height": { "type": "integer", "minimum": 256, "maximum": 2048 },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "description": "how the recorded narration is edited to the cut, and how much air follows each line",
          "properties": {
            "beat_pad_seconds": { "type": "number", "minimum": 0.2, "maximum": 3, "description": "silence after a line before the next beat; a shot may hold longer via duration_s" },
            "pause_cap_seconds": { "type": "number", "minimum": 0, "maximum": 2, "description": "hold every internal pause longer than this down to this (0 = leave the read as recorded)" },
            "narration_tempo": { "type": "number", "minimum": 0.5, "maximum": 2, "description": "pitch-preserving speed of the narration in the cut (1 = as recorded)" }
          }
        }
      }
    },
    "character_sheet": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 10 },
        "reference_notes": { "type": "string" }
      }
    },
    "characters": {
      "type": "array",
      "description": "the cast. Reference-conditioned image models use these to keep faces consistent across shots.",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10, "description": "what the character looks like: age, face, hair, clothing, build" }
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "bpm", "key", "instrumental"],
      "additionalProperties": false,
      "properties": {
        "caption": { "type": "string", "minLength": 10, "description": "ACE-Step caption: style, mood, instruments, texture, era" },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string", "minLength": 2 },
        "instrumental": { "type": "boolean" },
        "candidates": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 },
        "seed": { "type": "integer", "minimum": 0 },
        "lyrics": { "type": "string" }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 3 },
        "subtitle": { "type": "string" },
        "text_am": { "type": "string", "description": "Amharic proverb shown above the English line on the end card" },
        "seconds": { "type": "number", "minimum": 1.5, "maximum": 5, "default": 2.5 }
      }
    },
    "shots": {
      "type": "array", "minItems": 8, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "duration_s", "shot_size", "image_prompt", "motion_prompt", "narration", "reason", "seed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
          "duration_s": { "type": "number", "minimum": 3, "maximum": 20 },
          "shot_size": { "type": "string", "enum": ["extreme_wide", "wide", "medium", "medium_close", "close_up", "extreme_close", "insert"] },
          "framing": { "type": "string", "description": "optional editorial framing label, e.g. wide_to_medium, interaction_to_wide" },
          "image_prompt": { "type": "string", "minLength": 10, "description": "the still to generate; style_block is prepended automatically" },
          "motion_prompt": { "type": "string", "description": "for image-to-video: only motion and camera, never re-describe the subject" },
          "narration": {
            "type": "object",
            "required": ["lang", "text"],
            "additionalProperties": false,
            "properties": {
              "lang": { "type": "string", "minLength": 2 },
              "text": { "type": "string", "minLength": 2 },
              "en": { "type": "string", "description": "English translation used for subtitles when narration is not English" }
            }
          },
          "reason": { "type": "string", "minLength": 10, "description": "why this shot exists" },
          "characters": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
            "description": "ids from the top-level cast who are visible in this shot"
          },
          "seed": { "type": "integer", "minimum": 0 },
          "music_cue": { "type": "string", "description": "what the score should be doing here" }
        }
      }
    }
  }
}
