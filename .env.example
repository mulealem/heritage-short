# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Google AI Studio (https://aistudio.google.com/apikey) ---
# Used for: narration (TTS) and, optionally, drafting the storyboard.
GEMINI_API_KEY=
# Model names are env-configurable because free-tier model names change often
# (record every change in FAILURES.md).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- Cloudflare Workers AI (https://dash.cloudflare.com -> Workers AI) ---
# Used for: keyframes (FLUX).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_FLUX_MODEL=@cf/black-forest-labs/flux-schnell

# --- Voice ---
TTS_VOICE=Kore
