# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Keys are only needed for an asset that is NOT already in outputs/: a clone
# of the repository rebuilds both films with no keys at all (`make short`).
# The non-secret settings below match the code defaults, so the committed cache
# is recognised either way.

# --- Google AI Studio (https://aistudio.google.com/apikey) ---
# Used for: narration (TTS) and, optionally, drafting the storyboard.
GEMINI_API_KEY=
# Model names are env-configurable because free-tier model names change often
# (record every change in FAILURES.md).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TEXT_MODEL=gemini-3.8-flash

# --- MiniMax API platform (https://platform.minimax.io) ---
# Used for: comic keyframes, insert panels and cast references (image-01).
# NOTE: an sk-cp-* Coding Plan key can generate images but NOT video
# (see FAILURES.md F6). Video credits are separate.
MINIMAX_API_KEY=
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P

# --- Image provider for keyframes: minimax | cloudflare ---
IMAGE_PROVIDER=minimax

# --- Cloudflare Workers AI (https://dash.cloudflare.com -> Workers AI) ---
# Free daily neuron allowance (10k/day) — draft-quality alternative provider.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_FLUX_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# --- Voice ---
TTS_VOICE=Kore
